class student:
  def __init__(self,name,rollno,marks):
    self.name = name
    self.rollno = rollno
    self.marks = marks
  def display_details(self):
    print(f"name : {self.name}")
    print(f"rollno : {self.rollno}")
    print(f"marks : {self.marks}")
s1= student(name="ravi",rollno=101,marks=85)
s1.display_details()
